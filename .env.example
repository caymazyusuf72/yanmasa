# Model Sağlayıcısı: anthropic | openai (boş bırakılırsa anahtara göre otomatik seçilir)
LLM_PROVIDER=

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# OpenAI & OpenAI Uyumlu Sağlayıcılar (OpenAI, OpenRouter, Ollama, LM Studio, vLLM, DeepSeek vb.)
# Yerel sunucularda (Ollama vb.) OPENAI_API_KEY boş kalabilir veya "dummy" yazılabilir.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o


# ElevenLabs anahtar havuzu, virgülle ayrılmış. Biri tükenince sıradakine döner.
# Hepsi tükenince TTS otomatik olarak Piper'a düşer.
ELEVENLABS_KEYS=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# elevenlabs | piper
TTS_BACKEND=elevenlabs

# faster-whisper model boyutu: tiny | base | small | medium
STT_MODEL=small
STT_LANGUAGE=tr

# Uzak makine panelinin ön dolduracağı varsayılanlar. Boş bırakabilirsin.
# SSH_ALIAS doluysa geri kalanı yok sayılır ve ~/.ssh/config geçerli olur.
SSH_ALIAS=
SSH_HOST=
SSH_USER=root
SSH_PORT=22
